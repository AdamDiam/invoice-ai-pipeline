# Copy to .env and add your key. Never commit .env.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4-mini

# Pricing used for cost tracking (USD per 1M tokens). Defaults: gpt-5.4-mini list prices.
# PRICE_INPUT_PER_1M=0.75
# PRICE_OUTPUT_PER_1M=4.50

# Documents below this confidence always go to human review
# AUTO_APPROVE_CONFIDENCE=0.85
# INVOICEAI_DB_PATH=data/invoices.db
